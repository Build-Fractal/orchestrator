# OS
.DS_Store
Thumbs.db

# Orchestrator runtime state (derived, not source of truth for git)
.orchestrator/STATE.md
.orchestrator/orchestrator.lock
.orchestrator/execution-log.jsonl
.orchestrator/milestones/**/continue.md

# Ephemeral dispatch artifacts (rebuildable from task plan + state via build-context.sh)
.orchestrator/milestones/**/phases/*/tasks/T*-PAYLOAD.md
.orchestrator/milestones/**/phases/*/P*-PLANNING-PAYLOAD.md

# M013 GitHub integration sidecar — operator-owned, never committed
.orchestrator/integrations/github.json

# Claude Code harness transient state (regenerated per session)
.claude/scheduled_tasks.lock

# Ephemeral auto-loop transients (per-iteration output; not state of record)
.orchestrator/milestones/**/*-result.txt
.orchestrator/tmp/

# Transient phase-transition.sh inputs (raw/txt scratch files for --write derivation)
.orchestrator/milestones/**/phases/*/_fields/

# Transient phase-transition stderr captures (debug-only; not state of record)
.orchestrator/milestones/**/transition-*-stderr.txt

# Per-install manifest produced by install-claude-code.sh — generated artifact, not source
.orchestrator/installed-files.txt

# Compression caches (M018: tool-result paging + tier3 originals — disposable; rebuilt on demand)
.orchestrator/cache/

# Ephemeral conversus deliberation output (config committed; output directory is derived)
specs/**/conversus/

# Spec-kit extension install cache
.specify/extensions/.cache/
.specify/extensions/.backup/

# Knowledge graph database (derived artifact — rebuilt by rebuild-index.sh)
knowledge.db
knowledge.db-shm
knowledge.db-wal

# IDE
.idea/
.vscode/
*.swp
*.swo

# ── GSD baseline (auto-generated) ──
.gsd
# Exception: synthetic test fixtures under tests/fixtures/ must be tracked
!tests/fixtures/**/.gsd
!tests/fixtures/**/.gsd/**
*~
*.code-workspace
.env
.env.*
!.env.example
node_modules/
.next/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
target/
vendor/
*.log
coverage/
.cache/
tmp/

# M036 P02: orchestrator-owned binary preservation under Tier 0. CON-7 (b) — operators opt-in by listing exceptions.
.orchestrator/knowledge/reference/_originals/

# M036 P03: per-doc Tier 2 extraction-log (PASS / BLOCK gate-result records). Transient runtime artifact.
.orchestrator/knowledge/reference/_extraction-log/
